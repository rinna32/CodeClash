HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
RUST_LOG=info

# База — SQLite-файл рядом с проектом, создаётся сам
DATABASE_URL=sqlite://codeclash.db?mode=rwc

# Секрет для подписи токенов входа. Для деплоя — обязательно свой, длинный и случайный
JWT_SECRET=dev-secret-change-me

# ── Нейросеть (Qwen) — любой OpenAI-совместимый API ──
# Groq (бесплатно, ключ на console.groq.com → API Keys):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
# Локальная Ollama (ключ не нужен): LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=qwen2.5-coder:7b
